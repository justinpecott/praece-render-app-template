# Environment variables read by mysite/settings.py. Names only; never commit real values.

# Postgres connection string. Set in Render from render.yaml (internal connection string); leave unset locally to use SQLite.
DATABASE_URL=

# Long random string unique to this app. Generated by Render from render.yaml; optional locally.
SECRET_KEY=

# Set automatically by Render ("true"); turns off debug mode and requires DATABASE_URL and SECRET_KEY. Leave unset locally.
RENDER=

# Set automatically by Render to the service's onrender.com hostname; used for allowed hosts and form security. Leave unset locally.
RENDER_EXTERNAL_HOSTNAME=

# Custom domains pointed at this app, comma-separated (e.g. app.example.com,www.example.com).
# Each is allowed as a host and trusted for form submissions over https. Optional; leave unset if none.
CUSTOM_DOMAINS=

# First admin account, created on deploy by `manage.py ensure_superuser` only if no superuser exists.
# Skipped unless username and password are set; email is optional. Set on the Render service
# (Claude does this on the first deploy; see CLAUDE.md); never commit the password.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
